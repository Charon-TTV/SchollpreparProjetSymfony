                    </div>
                    <div class="card-body p-4">
                        {{ include('admin/admin_etablissement/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
