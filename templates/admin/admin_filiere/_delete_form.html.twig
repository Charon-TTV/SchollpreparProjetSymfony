<form method="post" action="{{ path('app_admin_filiere_delete', {'id': filiere.id}) }}" onsubmit="return confirm('Voulez-vous vraiment supprimer cette filière ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ filiere.id) }}">
    <button class="btn btn-danger btn-sm rounded-pill">
        <i class="feather icon-trash-2"></i> Supprimer la filière
    </button>
</form>
