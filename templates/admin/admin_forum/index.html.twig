{# templates/admin/admin_forum/index.html.twig #}
{% extends 'admin/base.html.twig' %}

{% block title %}Surveillance des Forums - Admin{% endblock %}

{% block body %}
    <div class="container-fluid">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="m-0 text-dark font-weight-bold">
                    <i class="feather icon-message-circle mr-2 text-info"></i>Surveillance des Forums
                </h5>
                <span class="badge badge-info">{{ forums|length }} forums sur cette page</span>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="thead-light">
                        <tr>
                            <th style="width: 50px;">#</th>
                            <th>Forum (Catégorie)</th>
                            <th class="text-center">Membres</th>
                            <th class="text-center">Messages</th>
                            <th class="text-center">Actions</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for forum in forums %}
                            <tr>
                                <td class="text-muted small">
                                    {{ (pageActuelle - 1) * 4 + loop.index }}
                                </td>
                                <td>
                                    <h6 class="m-0 font-weight-bold text-dark">{{ forum.nom }}</h6>
                                    <small class="text-muted">{{ forum.description|slice(0, 50) }}...</small>
                                </td>
                                <td class="text-center">
                                    <span class="badge rounded-pill bg-light-info text-info px-3">
                                        <i class="feather icon-users mr-1"></i>{{ forum.membres|length }}
                                    </span>
                                </td>
                                <td class="text-center">
                                    <span class="badge rounded-pill bg-light-danger text-danger px-3">
                                        <i class="feather icon-mail mr-1"></i>{{ forum.forumMessages|length }}
                                    </span>
                                </td>
                                <td class="text-center">
                                    <form method="post" action="{{ path('admin_forum_clear', {id: forum.id}) }}"
                                          onsubmit="return confirm('Attention : Tous les messages de ce forum seront supprimés définitivement. Continuer ?');"
                                          style="display:inline">
                                        <button class="btn btn-sm btn-outline-danger px-3 rounded-pill shadow-none">
                                            <i class="feather icon-trash-2 mr-1"></i> Vider le chat
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">Aucun forum trouvé.</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>

                {# --- NAVIGATION DE PAGINATION --- #}
                {% if pagesTotales > 1 %}
                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <div class="text-muted small">
                            Page <strong>{{ pageActuelle }}</strong> sur <strong>{{ pagesTotales }}</strong>
                        </div>
                        <nav aria-label="Page navigation">
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item {{ pageActuelle == 1 ? 'disabled' }}">
                                    <a class="page-link shadow-none" href="{{ path('admin_forum_index', {page: pageActuelle - 1}) }}">
                                        <i class="feather icon-chevron-left"></i>
                                    </a>
                                </li>

                                {% for i in 1..pagesTotales %}
                                    <li class="page-item {{ i == pageActuelle ? 'active' }}">
                                        <a class="page-link shadow-none" href="{{ path('admin_forum_index', {page: i}) }}">{{ i }}</a>
                                    </li>
                                {% endfor %}

                                <li class="page-item {{ pageActuelle == pagesTotales ? 'disabled' }}">
                                    <a class="page-link shadow-none" href="{{ path('admin_forum_index', {page: pageActuelle + 1}) }}">
                                        <i class="feather icon-chevron-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    <style>
        .badge-light-info { background-color: rgba(17, 193, 91, 0.1); color: #11c15b; }
        .badge-light-danger { background-color: rgba(255, 82, 82, 0.1); color: #ff5252; }
        .page-item.active .page-link { background-color: #7267EF !important; border-color: #7267EF !important; color: #fff !important; }
        .page-link { color: #252525; }
    </style>
{% endblock %}
