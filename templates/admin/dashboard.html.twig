{# templates/admin/dashboard.html.twig #}
{% extends 'admin/base.html.twig' %}

{% block page_title %}Résumé des activités{% endblock %}

{% block body %}
    {# --- SECTION DES CARTES DE STATISTIQUES --- #}
    <div class="row">
        {# Carte Filières #}
        <div class="col-md-6 col-xl-3">
            <div class="card bg-c-blue order-card shadow border-0 transition-hover">
                <div class="card-body">
                    <h6 class="text-white opacity-75">Filières Total</h6>
                    <h2 class="text-right text-white d-flex align-items-center justify-content-between">
                        <div class="icon-circle bg-white-opacity-20">
                            <i class="feather icon-book"></i>
                        </div>
                        <span class="counter font-weight-bold">{{ totalFilieres }}</span>
                    </h2>
                </div>
            </div>
        </div>

        {# Carte Établissements #}
        <div class="col-md-6 col-xl-3">
            <div class="card bg-c-green order-card shadow border-0 transition-hover">
                <div class="card-body">
                    <h6 class="text-white opacity-75">Établissements</h6>
                    <h2 class="text-right text-white d-flex align-items-center justify-content-between">
                        <div class="icon-circle bg-white-opacity-20">
                            <i class="feather icon-map-pin"></i>
                        </div>
                        <span class="counter font-weight-bold">{{ totalEtablissements }}</span>
                    </h2>
                </div>
            </div>
        </div>

        {# Carte Catégories #}
        <div class="col-md-6 col-xl-3">
            <div class="card bg-c-yellow order-card shadow border-0 transition-hover">
                <div class="card-body">
                    <h6 class="text-white opacity-75">Catégories</h6>
                    <h2 class="text-right text-white d-flex align-items-center justify-content-between">
                        <div class="icon-circle bg-white-opacity-20">
                            <i class="feather icon-tag"></i>
                        </div>
                        <span class="counter font-weight-bold">{{ totalCategories }}</span>
                    </h2>
                </div>
            </div>
        </div>

        {# Carte Utilisateurs #}
        <div class="col-md-6 col-xl-3">
            <div class="card bg-c-pink order-card shadow border-0 transition-hover">
                <div class="card-body">
                    <h6 class="text-white opacity-75">Utilisateurs Inscrits</h6>
                    <h2 class="text-right text-white d-flex align-items-center justify-content-between">
                        <div class="icon-circle bg-white-opacity-20">
                            <i class="feather icon-users"></i>
                        </div>
                        <span class="counter font-weight-bold">{{ totalUsers }}</span>
                    </h2>
                </div>
            </div>
        </div>
    </div>

    {# --- SECTION DES GRAPHIQUES --- #}
    <div class="row mt-4">
        <div class="col-xl-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 text-dark font-weight-bold">Activité des Forums</h5>
                    <small class="text-muted">Nombre de messages par catégorie</small>
                </div>
                <div class="card-body">
                    <canvas id="forumActivityChart" height="300"></canvas>
                </div>
            </div>
        </div>
        <div class="col-xl-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 text-dark font-weight-bold">Répartition Rôles</h5>
                    <small class="text-muted">Élèves vs Conseillers</small>
                </div>
                <div class="card-body d-flex align-items-center justify-content-center">
                    <canvas id="userRolesChart" height="300"></canvas>
                </div>
            </div>
        </div>
    </div>

    <style>
        /* Définition manuelle des couleurs pour garantir l'affichage */
        .bg-c-blue { background: linear-gradient(45deg,#4099ff,#73b4ff); }
        .bg-c-green { background: linear-gradient(45deg,#2ed8b6,#59e0c5); }
        .bg-c-yellow { background: linear-gradient(45deg,#FFB64D,#ffcb80); }
        .bg-c-pink { background: linear-gradient(45deg,#FF5370,#ff869a); }

        .order-card { color: #fff; }
        .opacity-75 { opacity: 0.75; }
        .bg-white-opacity-20 { background: rgba(255,255,255,0.2); }

        .icon-circle {
            width: 45px; height: 45px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }

        .transition-hover { transition: all 0.3s ease; }
        .transition-hover:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.12) !important;
        }
    </style>
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // 1. Graphique Activité Forums (Barres)
            const ctxForum = document.getElementById('forumActivityChart').getContext('2d');
            new Chart(ctxForum, {
                type: 'bar',
                data: {
                    labels: [{% for forum in forums %}'{{ forum.nom }}',{% endfor %}],
                    datasets: [{
                        label: 'Messages',
                        data: [{% for forum in forums %}{{ forum.forumMessages|length }},{% endfor %}],
                        backgroundColor: '#4e73df',
                        borderRadius: 5
                    }]
                },
                options: {
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: { y: { beginAtZero: true } }
                }
            });

            // 2. Graphique Rôles (Doughnut)
            const ctxRoles = document.getElementById('userRolesChart').getContext('2d');
            new Chart(ctxRoles, {
                type: 'doughnut',
                data: {
                    labels: ['Élèves', 'Conseillers', 'Admins'],
                    datasets: [{
                        data: [
                            {{ stats.eleves }},
                            {{ stats.conseillers }},
                            {{ stats.total - stats.eleves - stats.conseillers }}
                        ],
                        backgroundColor: ['#1cc88a', '#4e73df', '#f6c23e'],
                        borderWidth: 0
                    }]
                },
                options: {
                    maintainAspectRatio: false,
                    cutout: '75%',
                    plugins: { legend: { position: 'bottom' } }
                }
            });
        });
    </script>
{% endblock %}
