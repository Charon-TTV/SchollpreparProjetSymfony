{% extends 'admin/base.html.twig' %}

{% block page_title %}Gestion des Établissements{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-sm-12">
            <div class="card">
                <div class="card-header">
                    <h5>Liste des Universités & Écoles</h5>
                    <div class="card-header-right">
                        <a href="#" class="btn btn-success btn-sm rounded-pill">
                            <i class="feather icon-plus"></i> Ajouter un établissement
                        </a>
                    </div>
                </div>
                <div class="card-body table-border-style">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                            <tr>
                                <th>#</th>
                                <th>Nom de l'établissement</th>
                                <th>Ville</th>
                                <th>Type</th>
                                <th>Statut</th>
                                <th>Actions</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for e in etablissements %}
                                <tr>
                                    <td>{{ e.id }}</td>
                                    <td>
                                        <h6 class="m-0">{{ e.nom }}</h6>
                                    </td>
                                    <td>{{ e.ville }}</td>
                                    <td>
                                        {% if e.type == 'Public' %}
                                            <span class="badge badge-light-primary">{{ e.type }}</span>
                                        {% else %}
                                            <span class="badge badge-light-danger">{{ e.type }}</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <label class="badge {{ e.status == 'Actif' ? 'badge-success' : 'badge-warning' }}">
                                            {{ e.status }}
                                        </label>
                                    </td>
                                    <td>
                                        <a href="#" class="btn btn-icon btn-outline-info btn-sm" title="Modifier">
                                            <i class="feather icon-edit"></i>
                                        </a>
                                        <a href="#" class="btn btn-icon btn-outline-danger btn-sm" title="Supprimer">
                                            <i class="feather icon-trash-2"></i>
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
