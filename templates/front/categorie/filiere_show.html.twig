{# templates/front/categorie/filiere_show.html.twig #}

{% extends 'front/base.html.twig' %}

{% block title %}{{ filiere.nom }} - SchoolPrepar{% endblock %}

{% block body %}
    {# 1. HEADER AVEC FIL D'ARIANE COMPLET (Nouveau système de navigation) #}
    <section class="page-info-section set-bg" data-setbg="{{ asset('assets/front/img/page-bg/2.jpg') }}">
        <div class="container">
            <div class="site-breadcrumb">
                <a href="{{ path('app_home') }}">Accueil</a> /
                <a href="{{ path('app_categorie_index') }}">Catégories</a> /
                <a href="{{ path('app_categorie_show', {id: categorie.id}) }}">{{ categorie.nom }}</a> /
                <span style="color: #d82a2e;">{{ filiere.nom }}</span>
            </div>
        </div>
    </section>

    <section class="single-course-section spad">
        <div class="container">
            <div class="row">

                {# 2. COLONNE GAUCHE : DÉTAILS DU PROGRAMME (Design riche conservé) #}
                <div class="col-lg-8">
                    <div class="course-meta">
                        <div class="course-category" style="background: #d82a2e; color: #fff; display: inline-block; padding: 6px 20px; border-radius: 50px; font-weight: 600; margin-bottom: 15px;">
                            {{ categorie.nom }}
                        </div>
                        <h2 style="font-size: 42px; font-weight: 800; color: #252525; margin-bottom: 25px;">
                            {{ filiere.nom }}
                        </h2>
                    </div>

                    <div class="course-preview" style="margin-bottom: 35px; border-radius: 20px; overflow: hidden; box-shadow: 0 15px 35px rgba(0,0,0,0.1);">
                        <img src="{{ filiere.image ? asset('uploads/images/' ~ filiere.image) : asset('assets/front/img/courses/default-big.jpg') }}"
                             alt="{{ filiere.nom }}" style="width: 100%; height: 450px; object-fit: cover;">
                    </div>

                    <div class="course-description p-2">
                        <h4 style="margin-bottom: 20px; color: #d82a2e; font-weight: 700;">Présentation de la filière</h4>
                        <div style="font-size: 16px; line-height: 1.8; color: #555;">
                            {{ filiere.description|nl2br }}
                        </div>
                    </div>
                </div>

                {# 3. COLONNE DROITE : ÉTABLISSEMENTS PARTENAIRES (Design riche conservé) #}
                <div class="col-lg-4">
                    <div class="course-sidebar" style="background: #fff; padding: 35px; border-radius: 20px; border: 1px solid #f0f0f0; box-shadow: 0 5px 20px rgba(0,0,0,0.03);">
                        <div class="sb-widget">
                            <h4 class="sb-title" style="border-left: 5px solid #d82a2e; padding-left: 15px; margin-bottom: 30px; font-weight: 700;">
                                Universités & Écoles
                            </h4>

                            <div class="etablissement-cards">
                                {# On utilise filiere.etablissements comme dans l'ancien #}
                                {% for ecole in filiere.etablissements %}
                                    <div class="school-card" style="background: #fbfbfb; padding: 20px; border-radius: 12px; border: 1px solid #eee; margin-bottom: 20px; transition: 0.3s;">
                                        <div class="d-flex align-items-center">
                                            <div class="school-logo" style="width: 60px; height: 60px; background: #fff; border-radius: 10px; margin-right: 15px; display: flex; align-items: center; justify-content: center; overflow: hidden; border: 1px solid #f0f0f0;">
                                                {% if ecole.image %}
                                                    <img src="{{ asset('uploads/images/' ~ ecole.image) }}" alt="{{ ecole.nom }}" style="max-width: 100%;">
                                                {% else %}
                                                    <i class="fa fa-university" style="color: #d82a2e; font-size: 24px;"></i>
                                                {% endif %}
                                            </div>
                                            <div>
                                                <h6 style="margin: 0; font-weight: 700; color: #252525;">{{ ecole.nom }}</h6>
                                                <small class="text-muted"><i class="fa fa-map-marker text-danger"></i> {{ ecole.ville }}, Togo</small>
                                            </div>
                                        </div>
                                        <hr style="margin: 15px 0;">
                                        <a href="{{ path('app_etablissement_index') }}" style="font-size: 12px; color: #d82a2e; font-weight: 700; text-transform: uppercase; letter-spacing: 1px;">
                                            Profil de l'école <i class="fa fa-angle-right"></i>
                                        </a>
                                    </div>
                                {% else %}
                                    <div class="text-center py-4 bg-light rounded" style="border: 1px dashed #ccc;">
                                        <p class="text-muted small mb-0">Aucun établissement répertorié pour cette formation.</p>
                                    </div>
                                {% endfor %}
                            </div>

                            {# Box d'appel à l'action / Info complémentaire #}
                            <div class="promo-box" style="background: #252525; color: #fff; padding: 25px; border-radius: 15px; margin-top: 40px; text-align: center;">
                                <h6 class="text-white mb-2">Besoin d'aide ?</h6>
                                <p style="font-size: 13px; opacity: 0.8; margin-bottom: 20px;">Nos conseillers vous orientent gratuitement vers l'école idéale.</p>
                                <a href="{{ path('app_categorie_show', {id: categorie.id}) }}" class="btn btn-outline-light btn-sm w-100 mb-2" style="border-radius: 30px;">Retour à la catégorie</a>
                                <a href="#" class="site-btn btn-sm" style="background: #d82a2e; width: 100%; border-radius: 30px;">Nous contacter</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <style>
        .site-breadcrumb a { color: #fff; text-decoration: none; }
        .site-breadcrumb { color: #fff; font-size: 18px; font-weight: 600; margin-bottom: 10px; }
        .school-card:hover { transform: translateY(-5px); box-shadow: 0 5px 15px rgba(0,0,0,0.08); border-color: #d82a2e !important; }
    </style>
{% endblock %}
