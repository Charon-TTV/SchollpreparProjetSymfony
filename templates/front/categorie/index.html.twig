{% extends 'front/base.html.twig' %}

{% block title %}Domaines d'études - SchoolPrepar{% endblock %}

{% block body %}
    <section class="page-info-section set-bg" data-setbg="{{ asset('assets/front/img/page-bg/1.jpg') }}">
        <div class="container">
            <div class="site-breadcrumb">
                <a href="{{ path('app_home') }}">Accueil</a> /
                <span style="color: #d82a2e;">Catégories</span>
            </div>
            <h2 class="hp-title">Nos Domaines de Formation</h2>
        </div>
    </section>

    <section class="categories-section spad">
        <div class="container">
            <div class="row">
                {# On boucle sur les catégories paginées #}
                {% for c in categories %}
                    <div class="col-lg-4 col-md-6 mb-4 d-flex align-items-stretch">
                        <div class="categorie-item-glass" style="width: 100%; display: flex; flex-direction: column; background: #fff; box-shadow: 0 10px 25px rgba(0,0,0,0.07); border-radius: 12px; overflow: hidden; transition: 0.3s;">

                            {% set imageNumber = (loop.index0 % 4) + 1 %}
                            <div class="ci-thumb set-bg"
                                 data-setbg="{{ asset('assets/front/img/categories/' ~ imageNumber ~ '.jpg') }}"
                                 style="height: 180px; width: 100%;">
                            </div>

                            <div class="ci-text" style="padding: 20px; flex-grow: 1; display: flex; flex-direction: column; justify-content: space-between;">
                                <div>
                                    <h5 style="font-size: 17px; font-weight: 700; color: #252525; margin-bottom: 12px;">{{ c.nom }}</h5>
                                    <p style="font-size: 13.5px; color: #707070; line-height: 1.5; margin-bottom: 15px;">
                                        {{ c.description|length > 90 ? c.description|slice(0, 90) ~ '...' : c.description }}
                                    </p>
                                </div>

                                <div class="d-flex justify-content-between align-items-center" style="border-top: 1px solid #f5f5f5; padding-top: 15px; margin-top: 10px;">
                                    <span style="font-size: 12px; color: #d82a2e; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px;">
                                        {{ c.filieres|length }} Filières
                                    </span>
                                    <a href="{{ path('app_categorie_show', {'id': c.id}) }}" class="view-more-link" style="color: #252525; font-weight: 600; font-size: 14px; text-decoration: none;">
                                        Voir <i class="fa fa-angle-right ml-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="col-12 text-center py-5">
                        <p class="text-muted">Aucune catégorie disponible pour le moment.</p>
                    </div>
                {% endfor %}
            </div>

            {# --- AFFICHAGE DE LA PAGINATION --- #}
            <div class="site-pagination pt-5 d-flex justify-content-center">
                {{ knp_pagination_render(categories) }}
            </div>
        </div>
    </section>

    <style>
        /* Style pour personnaliser les boutons de pagination KNP */
        .pagination { display: flex; list-style: none; padding: 0; }
        .pagination li { margin: 0 5px; }
        .pagination li a, .pagination li span {
            display: inline-block;
            width: 40px;
            height: 40px;
            line-height: 40px;
            text-align: center;
            border-radius: 50%;
            background: #f0f0f0;
            color: #252525;
            font-weight: 600;
            transition: 0.3s;
            text-decoration: none;
        }
        .pagination li.active span { background: #d82a2e; color: #fff; }
        .pagination li a:hover { background: #d82a2e; color: #fff; }

        .categorie-item-glass:hover { transform: translateY(-8px); box-shadow: 0 15px 35px rgba(0,0,0,0.12); }
        .view-more-link:hover { color: #d82a2e !important; }
        .site-breadcrumb a { color: #fff; text-decoration: none; }
        .site-breadcrumb { color: #fff; font-size: 18px; font-weight: 600; margin-bottom: 10px; }
    </style>
{% endblock %}
