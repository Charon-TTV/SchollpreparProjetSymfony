{# templates/front/etablissement/index.html.twig #}
{% extends 'front/base.html.twig' %}

{% block title %}Nos Établissements - SchoolPrepar{% endblock %}

{% block body %}
    {# Section d'entête #}
    <section class="page-info-section set-bg" data-setbg="{{ asset('assets/front/img/page-bg/1.jpg') }}">
        <div class="container">
            <div class="site-breadcrumb">
                <a href="{{ path('app_home') }}">Accueil</a> /
                <span style="color: #d82a2e;">Établissements</span>
            </div>
            <h2 class="hp-title">Universités & Grandes Écoles</h2>
        </div>
    </section>

    <section class="course-section spad" style="background: #fbfbfb;">
        <div class="container">
            <div class="row">
                {% for e in etablissements %}
                    <div class="col-lg-4 col-md-6 mb-5 d-flex align-items-stretch">
                        {# Carte Style "Lomé" Épuré #}
                        <div class="categorie-item-glass" style="width: 100%; display: flex; flex-direction: column; background: #fff; box-shadow: 0 8px 20px rgba(0,0,0,0.05); border-radius: 15px; overflow: hidden; transition: 0.3s; border: 1px solid #f0f0f0;">

                            {# Image avec Badge Type #}
                            <div class="set-bg" data-setbg="{{ e.image ? asset('uploads/images/' ~ e.image) : asset('assets/front/img/categories/1.jpg') }}" style="height: 180px; width: 100%; position: relative;">
                                <div style="position: absolute; top: 15px; right: 15px; background: {{ e.type == 'Public' ? '#252525' : '#d82a2e' }}; color: white; padding: 4px 14px; border-radius: 20px; font-size: 11px; font-weight: 700;">
                                    {{ e.type|default('Privé') }}
                                </div>
                            </div>

                            {# Contenu de la carte #}
                            <div style="padding: 25px; flex-grow: 1; display: flex; flex-direction: column;">
                                <h5 style="font-weight: 700; color: #252525; margin-bottom: 8px; font-size: 18px;">{{ e.nom }}</h5>

                                <div style="font-size: 13px; color: #d82a2e; margin-bottom: 15px; font-weight: 600;">
                                    <i class="fa fa-map-marker"></i> {{ e.ville }}, Togo
                                </div>

                                <p style="font-size: 14px; color: #666; line-height: 1.6; margin-bottom: 20px;">
                                    {{ e.localisation|length > 90 ? e.localisation|slice(0, 90) ~ '...' : e.localisation }}
                                </p>

                                {# Bouton Vert Arrondi (Action principale) #}
                                <div class="mt-auto">
                                    <a href="{{ path('app_etablissement_show', {'id': e.id}) }}" class="btn btn-outline-success btn-block" style="border-radius: 25px; font-weight: 700; font-size: 14px; padding: 10px; transition: 0.3s; border-width: 1px;">
                                        Consulter l'établissement
                                    </a>
                                </div>

                                {# Footer discret #}
                                <div class="d-flex justify-content-between align-items-center mt-3 pt-3" style="border-top: 1px solid #f8f8f8;">
                                    <span style="font-size: 10px; color: #aaa; text-transform: uppercase; font-weight: 700;">
                                        <i class="fa fa-check text-success"></i> Accrédité
                                    </span>
                                    <a href="{{ path('app_etablissement_show', {'id': e.id}) }}" style="font-size: 12px; color: #252525; font-weight: 700; text-decoration: none;">
                                        Détails <i class="fa fa-angle-right"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="col-12 text-center py-5">
                        <div class="empty-state-glass p-5" style="background: #fff; border-radius: 15px; border: 2px dashed #eee;">
                            <i class="fa fa-university mb-3" style="font-size: 50px; color: #ccc;"></i>
                            <p class="text-muted">Aucun établissement répertorié pour le moment.</p>
                        </div>
                    </div>
                {% endfor %}
            </div>

            {# Pagination #}
            {% if pagesTotales > 1 %}
                <div class="site-pagination pt-5 d-flex justify-content-center">
                    <ul class="pagination">
                        <li class="{{ pageActuelle == 1 ? 'disabled' }}">
                            {% if pageActuelle > 1 %}
                                <a href="{{ path('app_etablissement_index', {page: pageActuelle - 1}) }}"><i class="fa fa-angle-left"></i></a>
                            {% else %}
                                <span><i class="fa fa-angle-left"></i></span>
                            {% endif %}
                        </li>

                        {% for i in 1..pagesTotales %}
                            <li class="{{ i == pageActuelle ? 'active' }}">
                                {% if i == pageActuelle %}
                                    <span>{{ i }}</span>
                                {% else %}
                                    <a href="{{ path('app_etablissement_index', {page: i}) }}">{{ i }}</a>
                                {% endif %}
                            </li>
                        {% endfor %}

                        <li class="{{ pageActuelle == pagesTotales ? 'disabled' }}">
                            {% if pageActuelle < pagesTotales %}
                                <a href="{{ path('app_etablissement_index', {page: pageActuelle + 1}) }}"><i class="fa fa-angle-right"></i></a>
                            {% else %}
                                <span><i class="fa fa-angle-right"></i></span>
                            {% endif %}
                        </li>
                    </ul>
                </div>
            {% endif %}
        </div>
    </section>

    <style>
        /* Styles de base */
        .site-breadcrumb a { color: #fff; text-decoration: none; }
        .site-breadcrumb { color: #fff; font-size: 18px; font-weight: 600; margin-bottom: 10px; }
        .hp-title { color: #fff; font-weight: 700; }

        /* Animation au survol */
        .categorie-item-glass:hover {
            transform: translateY(-8px);
            box-shadow: 0 12px 30px rgba(0,0,0,0.1) !important;
            border-color: #d82a2e !important;
        }

        /* Style bouton vert style "Lomé" */
        .btn-outline-success {
            color: #00c292;
            border-color: #00c292;
        }

        .btn-outline-success:hover {
            background-color: #00c292;
            border-color: #00c292;
            color: #fff;
        }

        /* Pagination Style */
        .pagination { display: flex; list-style: none; padding: 0; margin: 0; align-items: center; }
        .pagination li { margin: 0 8px; }
        .pagination li a, .pagination li span {
            display: flex; align-items: center; justify-content: center;
            width: 45px; height: 45px; border-radius: 50%;
            background: #fff; color: #2c3e50; font-weight: 600;
            font-size: 16px; border: 1px solid #ebedef;
            transition: all 0.3s ease; text-decoration: none !important;
        }
        .pagination li.active span {
            background: #d82a2e !important;
            color: #fff !important;
            border-color: #d82a2e !important;
            box-shadow: 0 4px 10px rgba(216, 42, 46, 0.3);
        }
        .pagination li.disabled span { color: #ccc; background: #f8f9fa; cursor: not-allowed; }
        .pagination li a:hover { border-color: #d82a2e; color: #d82a2e; transform: translateY(-2px); }
    </style>
{% endblock %}
