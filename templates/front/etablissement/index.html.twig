{% extends 'front/base.html.twig' %}

{% block title %}Nos Établissements - SchoolPrepar{% endblock %}

{% block body %}
    {# 1. Header de page #}
    <section class="page-info-section set-bg" data-setbg="{{ asset('assets/front/img/page-bg/1.jpg') }}">
        <div class="container">
            <div class="site-breadcrumb">
                <a href="{{ path('app_home') }}">Accueil</a> /
                <span>Établissements</span>
            </div>
            <h2 class="hp-title">Universités & Grandes Écoles</h2>
        </div>
    </section>

    {# 2. Barre de recherche #}
    <section class="search-section">
        <div class="container">
            <div class="search-warp">
                <div class="section-title text-white">
                    <h2>Trouvez l'établissement idéal</h2>
                    <p>Découvrez les meilleures institutions d'enseignement supérieur au Togo.</p>
                </div>
                <div class="row">
                    <div class="col-md-10 offset-md-1">
                        <form class="course-search-form">
                            <input type="text" placeholder="Nom de l'école (ex: Université de Lomé)">
                            <input type="text" class="last-m" placeholder="Ville">
                            <button class="site-btn">Rechercher</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {# 3. Grille des Établissements Dynamique #}
    <section class="course-section spad">
        <div class="container">
            <div class="row">
                {% for e in etablissements %}
                    <div class="col-lg-4 col-md-6 mb-5 d-flex align-items-stretch">
                        <div class="course-item" style="display: flex; flex-direction: column; width: 100%; border-radius: 10px; overflow: hidden; box-shadow: 0 10px 20px rgba(0,0,0,0.05); background: #fff;">
                            {# Image de l'école #}
                            <div class="course-thumb set-bg"
                                 data-setbg="{{ e.image ? asset('uploads/images/' ~ e.image) : asset('assets/front/img/categories/default.jpg') }}"
                                 style="height: 200px; width: 100%;">
                                <div class="price" style="background: {{ e.type == 'Public' ? '#252525' : '#d82a2e' }};">{{ e.type|default('Privé') }}</div>
                            </div>

                            {# Contenu #}
                            <div class="course-info" style="padding: 25px; flex-grow: 1; display: flex; flex-direction: column;">
                                <div class="course-text" style="flex-grow: 1; min-height: 140px;">
                                    <h5 style="color: #252525; font-weight: 700; margin-bottom: 5px;">{{ e.nom }}</h5>
                                    <div class="mb-3" style="color: #d82a2e; font-size: 13px; font-weight: 600;">
                                        <i class="fa fa-map-marker"></i> {{ e.ville }}, Togo
                                    </div>
                                    <p style="color: #707070; line-height: 1.5; font-size: 14px;">
                                        {{ e.localisation|length > 100 ? e.localisation|slice(0, 100) ~ '...' : e.localisation }}
                                    </p>
                                </div>

                                {# Bouton #}
                                <div class="course-author" style="border-top: 1px solid #eee; padding-top: 20px; margin-top: auto;">
                                    <a href="{{ path('app_etablissement_show', {'id': e.id}) }}" class="site-btn btn-sm" style="border-radius: 30px; width: 100%; text-align: center;">
                                        Voir les filières
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="col-12 text-center">
                        <p class="text-muted">Aucun établissement répertorié pour le moment.</p>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>
{% endblock %}
