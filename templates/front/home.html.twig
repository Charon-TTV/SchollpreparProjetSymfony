{% extends 'front/base.html.twig' %}

{% block title %}SchoolPrepar - Accueil{% endblock %}

{% block body %}
    {# Section Héro #}
    <section class="hero-section set-bg" data-setbg="{{ asset('assets/front/img/bg.jpg') }}">
        <div class="container">
            <div class="hero-text text-white text-center">
                <h2 style="font-size: 50px; font-weight: 800;">Préparez votre avenir avec SchoolPrepar</h2>
                <p>Trouvez les meilleures filières et établissements pour votre parcours académique au Togo.</p>
            </div>
            <div class="row">
                <div class="col-lg-10 offset-lg-1">
                    <form class="intro-newslatter">
                        <input type="text" placeholder="Quelle formation recherchez-vous ?">
                        <button class="site-btn">Rechercher</button>
                    </form>
                </div>
            </div>
        </div>
    </section>

    {# Section Domaines / Catégories DYNAMIQUES avec SLIDER #}
    <section class="categories-section spad">
        <div class="container">
            <div class="section-title">
                <h2>Nos Domaines de Formation</h2>
                <p>Explorez les secteurs porteurs pour construire votre carrière.</p>
            </div>

            {# Le conteneur du slider #}
            <div class="categories-slider owl-carousel">
                {% for c in categories %}
                    {# Changement pour col-lg-4 (qui correspond à 3 items par ligne) #}
                    <div class="item" style="padding: 15px;">
                        <div class="categorie-item" style="width: 100%; display: flex; flex-direction: column; background: #fff; box-shadow: 0 5px 15px rgba(0,0,0,0.05); border-radius: 10px; overflow: hidden; height: 100%;">

                            {# Image alternée #}
                            {% set imageNumber = (loop.index0 % 4) + 1 %}
                            <div class="ci-thumb set-bg"
                                 data-setbg="{{ asset('assets/front/img/categories/' ~ imageNumber ~ '.jpg') }}"
                                 style="height: 200px; width: 100%; background-size: cover; background-position: center;">
                            </div>

                            {# Contenu #}
                            <div class="ci-text" style="padding: 25px; flex-grow: 1; display: flex; flex-direction: column; justify-content: space-between;">
                                <div>
                                    <h5 style="font-size: 20px; font-weight: 700; margin-bottom: 12px; color: #252525;">{{ c.nom }}</h5>
                                    <p style="font-size: 15px; color: #707070; margin-bottom: 20px; line-height: 1.6;">
                                        {{ c.description|length > 100 ? c.description|slice(0, 100) ~ '...' : c.description }}
                                    </p>
                                </div>

                                <div class="d-flex justify-content-between align-items-center" style="border-top: 1px solid #f0f0f0; padding-top: 15px;">
                                    <span style="font-size: 13px; color: #d82a2e; font-weight: 700; text-transform: uppercase;">
                                        {{ c.filieres|length }} FILIÈRES
                                    </span>
                                    <a href="{{ path('app_categorie_show', {'id': c.id}) }}" class="btn-link text-dark" style="font-weight: 700;">
                                        Voir <i class="fa fa-angle-right"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="col-12 text-center">
                        <p class="text-muted">Aucune catégorie disponible pour le moment.</p>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>

    {# Section Statistiques #}
    <section class="milestone-section spad" style="background: #252525; padding: 60px 0;">
        <div class="container">
            <div class="row text-white text-center">
                <div class="col-lg-3 col-sm-6 mb-4">
                    <h2 style="color: #d82a2e; font-size: 40px; font-weight: 800;">150+</h2>
                    <p style="text-transform: uppercase; font-size: 12px; letter-spacing: 2px;">Filières</p>
                </div>
                <div class="col-lg-3 col-sm-6 mb-4">
                    <h2 style="color: #d82a2e; font-size: 40px; font-weight: 800;">45</h2>
                    <p style="text-transform: uppercase; font-size: 12px; letter-spacing: 2px;">Établissements</p>
                </div>
                <div class="col-lg-3 col-sm-6 mb-4">
                    <h2 style="color: #d82a2e; font-size: 40px; font-weight: 800;">5000+</h2>
                    <p style="text-transform: uppercase; font-size: 12px; letter-spacing: 2px;">Étudiants</p>
                </div>
                <div class="col-lg-3 col-sm-6 mb-4">
                    <h2 style="color: #d82a2e; font-size: 40px; font-weight: 800;">100%</h2>
                    <p style="text-transform: uppercase; font-size: 12px; letter-spacing: 2px;">Orientation</p>
                </div>
            </div>
        </div>
    </section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        $(document).ready(function(){
            $('.categories-slider').owlCarousel({
                loop: true,
                margin: 25,
                nav: false,
                dots: true,
                autoplay: true,
                autoplayTimeout: 4000,
                autoplayHoverPause: true,
                smartSpeed: 1000,
                responsive: {
                    0: {
                        items: 1
                    },
                    768: {
                        items: 2
                    },
                    1024: {
                        items: 3 // Affichage de 3 items sur grand écran
                    }
                }
            });
        });
    </script>
{% endblock %}
