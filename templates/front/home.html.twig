{% extends 'front/base.html.twig' %}

{% block title %}SchoolPrepar - Accueil{% endblock %}

{% block body %}
    {# Section Héro #}
    <section class="hero-section set-bg" data-setbg="{{ asset('assets/front/img/bg.jpg') }}">
        <div class="container">
            <div class="hero-text text-white">
                <h2>Préparez votre avenir avec SchoolPrepar</h2>
                <p>Trouvez les meilleures filières et établissements pour votre parcours académique au Togo.</p>
            </div>
            <div class="row">
                <div class="col-lg-10 offset-lg-1">
                    <form class="intro-newslatter">
                        <input type="text" placeholder="Votre Nom">
                        <input type="text" class="last-s" placeholder="Votre E-mail">
                        <button class="site-btn">S'inscrire</button>
                    </form>
                </div>
            </div>
        </div>
    </section>

    {# Section Domaines / Catégories #}
    <section class="categories-section spad">
        <div class="container">
            <div class="section-title">
                <h2>Nos Domaines de Formation</h2>
                <p>Explorez les secteurs porteurs pour construire votre carrière.</p>
            </div>
            <div class="row">
                {# Liste des 8 domaines avec données cohérentes #}
                {% set domaines = [
                    {'titre': 'Développement IT', 'desc': 'Programmation, Web et Mobile.', 'img': '1.jpg', 'count': '120 Filières'},
                    {'titre': 'Gestion & Finance', 'desc': 'Comptabilité, Audit et Banque.', 'img': '2.jpg', 'count': '85 Filières'},
                    {'titre': 'Santé & Médecine', 'desc': 'Soins infirmiers et Pharmacie.', 'img': '3.jpg', 'count': '40 Filières'},
                    {'titre': 'Droit & Sciences Po', 'desc': 'Juridique et Relations internationales.', 'img': '4.jpg', 'count': '55 Filières'},
                    {'titre': 'Marketing & Com', 'desc': 'Publicité et Stratégie digitale.', 'img': '1.jpg', 'count': '70 Filières'},
                    {'titre': 'Génie Civil', 'desc': 'Architecture et Construction.', 'img': '2.jpg', 'count': '35 Filières'},
                    {'titre': 'Agronomie', 'desc': 'Agriculture durable et Bio-industrie.', 'img': '3.jpg', 'count': '25 Filières'},
                    {'titre': 'Hôtellerie & Tourisme', 'desc': 'Gestion hôtelière et Gastronomie.', 'img': '4.jpg', 'count': '30 Filières'}
                ] %}

                {% for d in domaines %}
                    <div class="col-lg-3 col-md-6 mb-4 d-flex align-items-stretch">
                        <div class="categorie-item" style="width: 100%; display: flex; flex-direction: column; background: #fff; box-shadow: 0 5px 15px rgba(0,0,0,0.05); border-radius: 10px; overflow: hidden;">
                            {# Image avec hauteur fixe #}
                            <div class="ci-thumb set-bg"
                                 data-setbg="{{ asset('assets/front/img/categories/' ~ d.img) }}"
                                 style="height: 180px; width: 100%; background-size: cover; background-position: center;">
                            </div>

                            {# Texte avec hauteur minimale pour l'alignement #}
                            <div class="ci-text" style="padding: 20px; flex-grow: 1; display: flex; flex-direction: column; justify-content: space-between; min-height: 160px;">
                                <h5 style="font-size: 18px; font-weight: 700; margin-bottom: 10px; color: #252525;">{{ d.titre }}</h5>
                                <p style="font-size: 14px; color: #707070; margin-bottom: 15px;">{{ d.desc }}</p>
                                <span style="font-size: 13px; color: #d82a2e; font-weight: 600; text-transform: uppercase;">{{ d.count }}</span>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <section class="services-section spad" style="background: #fcfcfc;">
        <div class="container">
            <div class="row">
                <div class="col-lg-4 col-md-6 service-item">
                    <div class="si-icon" style="font-size: 40px; color: #d82a2e; margin-bottom: 20px;">
                        <i class="fa fa-search"></i>
                    </div>
                    <div class="si-text">
                        <h5>Recherche Intelligente</h5>
                        <p>Trouvez rapidement la filière qui correspond à vos ambitions grâce à nos filtres avancés.</p>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 service-item">
                    <div class="si-icon" style="font-size: 40px; color: #d82a2e; margin-bottom: 20px;">
                        <i class="fa fa-graduation-cap"></i>
                    </div>
                    <div class="si-text">
                        <h5>Établissements Certifiés</h5>
                        <p>Nous ne listons que les écoles et universités reconnues par l'État et le CAMES.</p>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 service-item">
                    <div class="si-icon" style="font-size: 40px; color: #d82a2e; margin-bottom: 20px;">
                        <i class="fa fa-briefcase"></i>
                    </div>
                    <div class="si-text">
                        <h5>Orientation Carrière</h5>
                        <p>Découvrez les débouchés réels pour chaque formation avant de vous inscrire.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {# Section Bannière finale (Ajustée pour être plus compacte) #}
    <section class="milestone-section spad" style="background: #252525; padding: 80px 0;">
        <div class="container">
            <div class="row text-white text-center">
                <div class="col-lg-3 col-sm-6 mb-4">
                    <div class="milestone">
                        <h2 style="color: #d82a2e; font-size: 48px; font-weight: 800; margin-bottom: 10px;">150+</h2>
                        <p style="text-transform: uppercase; font-size: 13px; letter-spacing: 2px;">Filières</p>
                    </div>
                </div>
                <div class="col-lg-3 col-sm-6 mb-4">
                    <div class="milestone">
                        <h2 style="color: #d82a2e; font-size: 48px; font-weight: 800; margin-bottom: 10px;">45</h2>
                        <p style="text-transform: uppercase; font-size: 13px; letter-spacing: 2px;">Établissements</p>
                    </div>
                </div>
                <div class="col-lg-3 col-sm-6 mb-4">
                    <div class="milestone">
                        <h2 style="color: #d82a2e; font-size: 48px; font-weight: 800; margin-bottom: 10px;">5000+</h2>
                        <p style="text-transform: uppercase; font-size: 13px; letter-spacing: 2px;">Étudiants</p>
                    </div>
                </div>
                <div class="col-lg-3 col-sm-6 mb-4">
                    <div class="milestone">
                        <h2 style="color: #d82a2e; font-size: 48px; font-weight: 800; margin-bottom: 10px;">100%</h2>
                        <p style="text-transform: uppercase; font-size: 13px; letter-spacing: 2px;">Orientation</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
