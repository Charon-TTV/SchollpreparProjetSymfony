{# templates/front/social/index.html.twig #}

{% extends 'front/base.html.twig' %}

{% block title %}Mon Espace Social - SchoolPrepar{% endblock %}

{% block body %}
    {# Section d'entête #}
    <section class="page-info-section set-bg" data-setbg="{{ asset('assets/front/img/page-bg/1.jpg') }}">
        <div class="container">
            <div class="site-breadcrumb">
                <a href="{{ path('app_home') }}">Accueil</a> /
                <span style="color: #d82a2e;">Mon Espace Social</span>
            </div>
            <h2 class="hp-title">Mes Forums de Discussion</h2>
        </div>
    </section>

    <section class="categories-section spad">
        <div class="container">
            <div class="row">
                {# 1. Affichage des forums déjà rejoints #}
                {% for forum in mesForums %}
                    <div class="col-lg-4 col-md-6 mb-4 d-flex align-items-stretch">
                        <div class="categorie-item-glass" style="width: 100%; display: flex; flex-direction: column; background: #fff; box-shadow: 0 10px 25px rgba(0,0,0,0.07); border-radius: 12px; overflow: hidden; transition: 0.3s;">
                            {% set imageNumber = (loop.index0 % 4) + 1 %}
                            <div class="ci-thumb set-bg" data-setbg="{{ asset('assets/front/img/categories/' ~ imageNumber ~ '.jpg') }}" style="height: 180px; width: 100%;"></div>

                            <div class="ci-text" style="padding: 20px; flex-grow: 1; display: flex; flex-direction: column; justify-content: space-between;">
                                <div>
                                    <h5 style="font-size: 17px; font-weight: 700; color: #252525; margin-bottom: 12px;">{{ forum.nom }}</h5>
                                    <p style="font-size: 13.5px; color: #707070; line-height: 1.5; margin-bottom: 15px;">
                                        {{ forum.description|length > 90 ? forum.description|slice(0, 90) ~ '...' : forum.description }}
                                    </p>
                                </div>

                                <div class="mb-3">
                                    <a href="{{ path('app_social_chat', {id: forum.id}) }}" class="btn btn-success btn-sm btn-block mb-2" style="border-radius: 20px; font-weight: 600;">
                                        <i class="fa fa-comments"></i> Accéder au Chat
                                    </a>
                                    <a href="{{ path('app_social_quitter', {id: forum.id}) }}" class="btn btn-outline-danger btn-sm btn-block" style="border-radius: 20px; font-weight: 600; font-size: 12px;" onclick="return confirm('Quitter le forum {{ forum.nom }} ?')">
                                        <i class="fa fa-sign-out"></i> Quitter ce forum
                                    </a>
                                </div>

                                <div class="d-flex justify-content-between align-items-center" style="border-top: 1px solid #f5f5f5; padding-top: 15px; margin-top: 10px;">
                                    <span style="font-size: 11px; color: #707070; font-weight: 600; text-transform: uppercase;">
                                        <i class="fa fa-circle text-success mr-1"></i> Membre actif
                                    </span>
                                    <a href="{{ path('app_social_show', {'id': forum.id}) }}" class="view-more-link" style="color: #252525; font-weight: 600; font-size: 14px; text-decoration: none;">
                                        Détails <i class="fa fa-angle-right ml-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}

                {# 2. La Carte "Ajouter" (Apparaît si moins de 3 forums) #}
                {% if mesForums|length < 3 %}
                    <div class="col-lg-4 col-md-6 mb-4 d-flex align-items-stretch">
                        <a href="{{ path('app_categorie_index') }}" class="add-forum-card w-100 d-flex align-items-center justify-content-center" style="text-decoration: none;">
                            <div class="text-center p-4">
                                <div class="icon-box mb-3">
                                    <i class="fa fa-plus-circle"></i>
                                </div>
                                <h5 class="m-0" style="color: #252525; font-weight: 700;">Rejoindre un autre forum</h5>
                                <p class="text-muted mt-2" style="font-size: 13px;">
                                    Il vous reste {{ 3 - mesForums|length }} place(s) disponible(s)
                                </p>
                            </div>
                        </a>
                    </div>
                {% endif %}

                {# 3. État vide (uniquement si 0 forum) #}
                {% if mesForums is empty %}
                    <div class="col-12 text-center py-5">
                        <div class="empty-state-glass p-5" style="background: #f8f9fa; border-radius: 15px; border: 2px dashed #dee2e6;">
                            <i class="fa fa-users mb-3" style="font-size: 50px; color: #dee2e6;"></i>
                            <h4 style="color: #252525;">Vous n'avez rejoint aucun forum</h4>
                            <p class="text-muted mb-4">Rejoignez des communautés pour discuter avec d'autres étudiants et conseillers.</p>
                            <a href="{{ path('app_categorie_index') }}" class="btn btn-primary" style="background-color: #d82a2e; border: none; border-radius: 25px; padding: 10px 25px;">
                                Parcourir les catégories
                            </a>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </section>

    <style>
        .categorie-item-glass:hover { transform: translateY(-8px); box-shadow: 0 15px 35px rgba(0,0,0,0.12); }
        .view-more-link:hover { color: #d82a2e !important; }
        .site-breadcrumb a { color: #fff; text-decoration: none; }
        .site-breadcrumb { color: #fff; font-size: 18px; font-weight: 600; margin-bottom: 10px; }
        .hp-title { color: #fff; font-weight: 700; }

        /* Style de la carte "Ajouter" */
        .add-forum-card {
            border: 3px dashed #dee2e6;
            border-radius: 12px;
            background: rgba(0,0,0,0.02);
            transition: 0.3s;
            min-height: 350px; /* Aligné sur la hauteur des autres cartes */
        }
        .add-forum-card .icon-box i {
            font-size: 50px;
            color: #d82a2e;
            transition: 0.3s;
        }
        .add-forum-card:hover {
            background: #fff;
            border-color: #d82a2e;
            transform: translateY(-8px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.05);
        }
        .add-forum-card:hover .icon-box i {
            transform: scale(1.1);
        }

        .btn-outline-danger:hover {
            background-color: #ff4d4d;
            border-color: #ff4d4d;
            color: white !important;
        }
    </style>
{% endblock %}
